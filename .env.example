PUBLIC_SITE_NAME="Silva Cleaning"
PUBLIC_SITE_URL="http://localhost:4321"

# Explicit demo mode. Use true for local demos without Supabase/Stripe. Set false in production.
DEMO_MODE="true"

# Supabase free tier
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
PUBLIC_SUPABASE_ANON_KEY=""

# Stripe has no monthly fee, only transaction fees.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Simple admin lock for the starter. Replace with Supabase Auth before production.
ADMIN_ACCESS_TOKEN="change-me-before-deploy"

# Optional free email provider such as Resend or Brevo.
EMAIL_API_KEY=""
ADMIN_EMAIL="owner@example.com"
