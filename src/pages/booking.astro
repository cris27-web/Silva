---
import BaseLayout from "../components/layout/BaseLayout.astro";
import BookingApp from "../components/booking/BookingApp";
---

<BaseLayout title="Book Cleaning | Silva Cleaning">
  <section class="page-hero compact">
    <p class="eyebrow">Book online</p>
    <h1>Book your cleaning slot</h1>
    <p>Choose a service, add property and access details, then continue to secure payment or confirmation. No cash needed on the day.</p>
  </section>
  <section class="section booking-shell reveal">
    <BookingApp client:load />
  </section>
</BaseLayout>
