---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout title="Contact | Silva Cleaning">
  <section class="page-hero compact">
    <p class="eyebrow">Contact</p>
    <h1>Need help before booking?</h1>
    <p>Use the booking flow for fastest confirmation, or contact the team for custom jobs.</p>
  </section>
  <section class="section contact-grid reveal">
    <a class="contact-card" href="tel:+440000000000"><strong>Phone</strong><span>+44 0000 000000</span></a>
    <a class="contact-card" href="mailto:hello@example.com"><strong>Email</strong><span>hello@example.com</span></a>
    <div class="contact-card"><strong>Areas</strong><span>Bristol and nearby postcodes</span></div>
  </section>
</BaseLayout>
