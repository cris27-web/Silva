---
import BaseLayout from "../components/layout/BaseLayout.astro";
import ReviewForm from "../components/reviews/ReviewForm";
import { reviews } from "../data/reviews";
---

<BaseLayout title="Reviews | Silva Cleaning">
  <section class="page-hero compact">
    <p class="eyebrow">Reviews</p>
    <h1>What customers say</h1>
    <p>Approved customer feedback appears here. New reviews can be moderated from admin.</p>
  </section>
  <section class="section review-grid reveal">
    {reviews.map((review) => (
      <article class="review-card">
        <div class="stars">★★★★★</div>
        <p>"{review.text}"</p>
        <strong>{review.name}</strong>
        <span>{review.area}</span>
      </article>
    ))}
  </section>
  <section class="section narrow reveal">
    <ReviewForm client:load />
  </section>
</BaseLayout>
