---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { services } from "../data/services";
import { reviews } from "../data/reviews";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Bristol home cleaning, booked online</p>
      <h1>Silva Cleaning</h1>
      <p class="hero-text">Reliable regular, deep, and end-of-tenancy cleaning with clear prices, fast confirmation, and secure cash-free payment.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/booking">Book a clean</a>
        <a class="button button-secondary" href="/services">View services</a>
      </div>
      <div class="trust-row" aria-label="Service highlights">
        <span>Secure online payment</span>
        <span>Domestic and tenancy cleans</span>
        <span>Fast mobile booking</span>
      </div>
    </div>
    <div class="hero-media" aria-label="Cleaner preparing a bright kitchen">
      <div class="shine-line"></div>
      <div class="hero-badge">
        <strong>4.9/5</strong>
        <span>Average review</span>
      </div>
    </div>
  </section>

  <section class="proof-strip" aria-label="Silva Cleaning proof points">
    <div><strong>3</strong><span>Core services</span></div>
    <div><strong>24h</strong><span>Typical confirmation</span></div>
    <div><strong>100%</strong><span>Cash-free checkout</span></div>
    <div><strong>Bristol</strong><span>Local coverage</span></div>
  </section>

  <section class="section reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Services</p>
        <h2>Pick the clean that fits the job</h2>
      </div>
      <a class="text-link" href="/services">Compare all services</a>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <div>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
          </div>
          <p class="best-for">{service.bestFor}</p>
          <ul>
            {service.highlights.map((item) => <li>{item}</li>)}
          </ul>
          <div class="card-footer">
            <span>From &pound;{service.basePrice}</span>
            <a href={`/booking?service=${service.id}`}>Book</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section split-band reveal">
    <div>
      <p class="eyebrow">How it works</p>
      <h2>Simple enough to finish on your phone</h2>
    </div>
    <div class="steps">
      <div><span>1</span><strong>Choose service</strong><p>Select a regular, deep, or tenancy clean.</p></div>
      <div><span>2</span><strong>Pick a slot</strong><p>Choose a date and time that works for you.</p></div>
      <div><span>3</span><strong>Pay online</strong><p>Confirm securely through Stripe Checkout.</p></div>
    </div>
  </section>

  <section class="section quality-band reveal">
    <div>
      <p class="eyebrow">Quality standard</p>
      <h2>Cleaner homes, clearer expectations</h2>
      <p>Every booking collects the details cleaners need before arrival: property size, access notes, timing, and the exact service selected.</p>
    </div>
    <div class="quality-list">
      <span>Transparent starting prices</span>
      <span>Secure checkout when Stripe is enabled</span>
      <span>Receipts and booking records</span>
      <span>Admin dashboard for managing jobs</span>
    </div>
  </section>

  <section class="section reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Reviews</p>
        <h2>Built around trust</h2>
      </div>
      <a class="text-link" href="/reviews">Read reviews</a>
    </div>
    <div class="review-grid">
      {reviews.map((review) => (
        <article class="review-card">
          <div class="stars" aria-label="Five star review">*****</div>
          <p>"{review.text}"</p>
          <strong>{review.name}</strong>
          <span>{review.area}</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
